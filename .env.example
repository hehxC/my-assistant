DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
AMAP_API_KEY=your-amap-web-service-api-key
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
LIBRARY_STORAGE_DIR=data/library
LIBRARY_MAX_UPLOAD_MB=50
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=my-assistant
REDIS_URL=redis://127.0.0.1:6379
SESSION_COOKIE_SECURE=false
